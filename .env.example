# PostgreSQL настройки
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# Auth Service
AUTH_POSTGRES_DB=auth_db
AUTH_DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@auth-postgres:5432/auth_db
AUTH_SECRET_KEY=your_auth_secret_key_here

# Movie Service
MOVIE_POSTGRES_DB=movie_db
MOVIE_DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@movie-postgres:5432/movie_db
MOVIE_SECRET_KEY=your_movie_secret_key_here
MOVIE_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Elasticsearch
ELASTIC_VERSION=8.13.4
SEARCH_URL=http://elasticsearch:9200
SEARCH_INDEX=movies
SEARCH_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
SEARCH_KAFKA_GROUP_ID=search-service